{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubeassist.local/schemas/diagnostic-snapshot.schema.json",
  "title": "DiagnosticSnapshot",
  "description": "Redacted cluster evidence produced by the Go collector and consumed by the Python AI service. Detectors run in Go and populate the detector field before this is sent to AI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cluster",
    "pod",
    "containers",
    "conditions",
    "events",
    "logs",
    "detector",
    "collectedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "serverVersion"],
      "properties": {
        "name": { "type": "string" },
        "serverVersion": {
          "type": "string",
          "description": "Kubernetes server version, e.g. v1.31.0"
        }
      }
    },
    "pod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "namespace", "phase"],
      "properties": {
        "name": { "type": "string" },
        "namespace": { "type": "string" },
        "phase": {
          "type": "string",
          "enum": ["Pending", "Running", "Succeeded", "Failed", "Unknown"]
        },
        "nodeName": { "type": ["string", "null"] },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Scrubbed; sensitive annotations removed"
        },
        "ownerRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "name"],
            "properties": {
              "kind": { "type": "string" },
              "name": { "type": "string" },
              "apiVersion": { "type": "string" }
            }
          }
        }
      }
    },
    "containers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "image", "ready", "restartCount"],
        "properties": {
          "name": { "type": "string" },
          "image": { "type": "string" },
          "ready": { "type": "boolean" },
          "restartCount": { "type": "integer", "minimum": 0 },
          "state": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "waiting": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "properties": {
                  "reason": { "type": "string" },
                  "message": { "type": "string" }
                }
              },
              "running": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "properties": {
                  "startedAt": { "type": "string" }
                }
              },
              "terminated": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "properties": {
                  "reason": { "type": "string" },
                  "message": { "type": "string" },
                  "exitCode": { "type": "integer" },
                  "finishedAt": { "type": "string" }
                }
              }
            }
          },
          "lastState": {
            "type": ["object", "null"],
            "description": "Same shape as state; used for OOM/CrashLoop previous termination"
          },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requests": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "limits": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            }
          },
          "probes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "liveness": { "type": ["object", "null"] },
              "readiness": { "type": ["object", "null"] },
              "startup": { "type": ["object", "null"] }
            }
          }
        }
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "status"],
        "properties": {
          "type": { "type": "string" },
          "status": { "type": "string" },
          "reason": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "reason", "message"],
        "properties": {
          "type": { "type": "string" },
          "reason": { "type": "string" },
          "message": { "type": "string" },
          "count": { "type": "integer" },
          "lastTimestamp": { "type": "string" }
        }
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "previous", "truncated", "unavailableReason"],
      "properties": {
        "current": { "type": ["string", "null"] },
        "previous": {
          "type": ["string", "null"],
          "description": "Only populated when restartCount > 0"
        },
        "truncated": { "type": "boolean" },
        "unavailableReason": {
          "type": ["string", "null"],
          "description": "e.g. Pending pod has no logs yet"
        }
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaSet": { "type": ["object", "null"] },
        "deployment": { "type": ["object", "null"] },
        "yamlExcerpts": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Sanitized YAML snippets only"
        }
      }
    },
    "related": {
      "type": "object",
      "additionalProperties": false,
      "description": "Pass-2 expansions; omit or empty when not needed",
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "selector": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "endpointCount": { "type": "integer" }
            }
          }
        },
        "configMapRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "keysPresent": {
                "type": "array",
                "items": { "type": "string" }
              },
              "keysMissing": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failureType", "confidence", "evidence", "searchTerms"],
      "properties": {
        "failureType": {
          "type": "string",
          "enum": [
            "Healthy",
            "CrashLoopBackOff",
            "ProbeFailure",
            "ImagePullBackOff",
            "OOMKilled",
            "CreateContainerConfigError",
            "FailedScheduling",
            "ServiceSelectorMismatch",
            "Unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "searchTerms": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Used by FAISS retriever; set by Go detectors"
        },
        "relatedHints": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "userQuestion": {
      "type": "string",
      "default": ""
    },
    "serviceName": {
      "type": ["string", "null"],
      "description": "Optional Service to evaluate for selector/endpoint issues"
    },
    "collectedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
